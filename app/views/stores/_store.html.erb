<div id="<%= dom_id store %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= store.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Code:</strong>
    <%= store.code %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Area:</strong>
    <%= store.area %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Manager name:</strong>
    <%= store.manager_name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Phone:</strong>
    <%= store.phone %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Email:</strong>
    <%= store.email %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Status:</strong>
    <%= store.status %>
  </div>
</div>
