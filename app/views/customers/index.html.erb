<div class="w-full">
  <h1 class="font-bold text-4xl">Customers</h1>

  <div id="customers" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @customers.any? %>
      <% @customers.each do |customer| %>
        <div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0">
          <%= render customer %>
          <%= link_to "Show",customer,class:"w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium"%>
          <%= link_to "Edit", edit_customer_path(customer), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
            <%= button_to "Destroy", customer, method: :delete, class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">No customers found</p>
    <% end %>
  </div>
</div>