<%= form_with(model: trainer, class: "contents") do |form| %>
  <% if trainer.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(trainer.errors.count, "error") %> prohibited this trainer from being saved:</h2>

      <ul class="list-disc ml-6">
        <% trainer.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :name %>
    <%= form.text_field :name, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": trainer.errors[:name].none?, "border-red-400 focus:outline-red-600": trainer.errors[:name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :role %>
    <%= form.number_field :role, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": trainer.errors[:role].none?, "border-red-400 focus:outline-red-600": trainer.errors[:role].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :employment_type %>
    <%= form.number_field :employment_type, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": trainer.errors[:employment_type].none?, "border-red-400 focus:outline-red-600": trainer.errors[:employment_type].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :store_id %>
    <%= form.number_field :store_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": trainer.errors[:store_id].none?, "border-red-400 focus:outline-red-600": trainer.errors[:store_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :phone %>
    <%= form.text_field :phone, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": trainer.errors[:phone].none?, "border-red-400 focus:outline-red-600": trainer.errors[:phone].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :email %>
    <%= form.text_field :email, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": trainer.errors[:email].none?, "border-red-400 focus:outline-red-600": trainer.errors[:email].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :session_price %>
    <%= form.number_field :session_price, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": trainer.errors[:session_price].none?, "border-red-400 focus:outline-red-600": trainer.errors[:session_price].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :registered_on %>
    <%= form.date_field :registered_on, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": trainer.errors[:registered_on].none?, "border-red-400 focus:outline-red-600": trainer.errors[:registered_on].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>

<% end %>