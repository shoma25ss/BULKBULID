<div class="w-full">
  <h1 class="font-bold text-4xl">Trainers</h1>

  <div id="trainers" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @trainers.any? %>
      <% @trainers.each do |trainer| %>
        <div class="flex flex-col sm:flex-row justify-between items-center pb-5 sm:pb-0">
          <%= render trainer %>
          <%= link_to "show",trainer,class:"w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium"%>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">No trainers found</p>
    <% end %>
  </div>
</div>