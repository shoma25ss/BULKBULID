<div id="<%= dom_id trainer %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= trainer.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Store:</strong>
    <%= trainer.store.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Phone:</strong>
    <%= trainer.phone %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Email:</strong>
    <%= trainer.email %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Session price:</strong>
    <%= trainer.session_price %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Registered on:</strong>
    <%= trainer.registered_on %>
  </div>
  <div>
  <strong class="block font-medium mb-1">Role:</strong>
  <%= trainer.role %>
</div>
<div>
  <strong class="block font-medium mb-1">Employment type:</strong>
  <%= trainer.employment_type %>
</div>
</div>
